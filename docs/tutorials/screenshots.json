{
  "formatVersion": 1,
  "status": "blocked-until-dsl4-release",
  "targetDslVersion": "4.0",
  "capturePolicy": {
    "fileRoot": "docs/images/tutorials/dsl4",
    "format": "png",
    "sourceTextPresentation": "copyable-code-block",
    "cameraSubject": "consenting-adult",
    "recordForEachCapture": [
      "application version",
      "source commit",
      "sample artifact integrity",
      "browser version",
      "viewport",
      "device pixel ratio"
    ]
  },
  "gates": [
    {
      "id": "dsl4-release",
      "ready": false,
      "description": "DSL 4.0の公開versionと対象commitが固定されている",
      "dependencies": ["https://github.com/kubohiroya/tmpose-kamishibai/issues/266"]
    },
    {
      "id": "tutorial-sample",
      "ready": false,
      "description": "最小作品、starter、Web版、SB3、公開URL、integrityが固定されている",
      "dependencies": ["kubohiroya/tmpose-kamishibai-samples: follow-up issue required"]
    },
    {
      "id": "app-shell",
      "ready": false,
      "description": "Standard Web playerとapp shellの配置、状態、文言が固定されている",
      "dependencies": ["https://github.com/kubohiroya/tmpose-kamishibai/issues/265"]
    },
    {
      "id": "preview-flow",
      "ready": false,
      "description": "development preview、reload選択、診断UIが固定されている",
      "dependencies": [
        "https://github.com/kubohiroya/tmpose-kamishibai/issues/258",
        "https://github.com/kubohiroya/tmpose-kamishibai/issues/266",
        "https://github.com/kubohiroya/tmpose-kamishibai/issues/390",
        "https://github.com/kubohiroya/tmpose-kamishibai/issues/391"
      ]
    },
    {
      "id": "pose-feedback",
      "ready": false,
      "description": "ポーズ認識度、チャージ、状態feedbackの正式表示が固定されている",
      "dependencies": ["https://github.com/kubohiroya/tmpose-kamishibai/issues/383"]
    },
    {
      "id": "camera-controls",
      "ready": false,
      "description": "camera preview、mirroring、camera選択UIの採用範囲が固定されている",
      "dependencies": ["https://github.com/kubohiroya/tmpose-kamishibai/issues/388"]
    },
    {
      "id": "cli-contract",
      "ready": false,
      "description": "validate、preview、buildの正式CLIとresource limitが固定されている",
      "dependencies": [
        "https://github.com/kubohiroya/tmpose-kamishibai/issues/258",
        "https://github.com/kubohiroya/tmpose-kamishibai/issues/266"
      ]
    },
    {
      "id": "capture-environment",
      "ready": false,
      "description": "撮影同意、背景、個人情報除去、browser、viewport、DPRが固定されている",
      "dependencies": []
    }
  ],
  "captures": [
    {
      "id": "P-01",
      "tutorial": "play",
      "step": 1,
      "required": true,
      "status": "blocked",
      "surface": "sample story detail",
      "description": "サンプル作品詳細とWeb版を開く導線",
      "filename": "docs/images/tutorials/dsl4/play/tutorial-play-01-sample-page.png",
      "captionDraft": "チュートリアル用作品の詳細ページからWeb版を開きます。",
      "altDraft": "チュートリアル用作品の詳細とWeb版を開く導線が表示されたサンプルサイト",
      "gates": ["dsl4-release", "tutorial-sample"]
    },
    {
      "id": "P-02",
      "tutorial": "play",
      "step": 2,
      "required": true,
      "status": "blocked",
      "surface": "Standard app shell title",
      "description": "DSL 4.0 app shellのタイトル画面",
      "filename": "docs/images/tutorials/dsl4/play/tutorial-play-02-title.png",
      "captionDraft": "タイトル画面から紙芝居を開始します。",
      "altDraft": "紙芝居のタイトルと開始操作が表示されたDSL 4.0 app shell",
      "gates": ["dsl4-release", "tutorial-sample", "app-shell"]
    },
    {
      "id": "P-03",
      "tutorial": "play",
      "step": 2,
      "required": true,
      "status": "blocked",
      "surface": "Standard app shell loading",
      "description": "Loading画面と進捗",
      "filename": "docs/images/tutorials/dsl4/play/tutorial-play-03-loading.png",
      "captionDraft": "台本とアセットの準備が終わるまでLoading画面で待ちます。",
      "altDraft": "台本とアセットの準備状況を示すLoading画面",
      "gates": ["dsl4-release", "tutorial-sample", "app-shell"]
    },
    {
      "id": "P-04",
      "tutorial": "play",
      "step": 3,
      "required": true,
      "status": "blocked",
      "surface": "browser permission",
      "description": "ブラウザのカメラ許可ダイアログ",
      "filename": "docs/images/tutorials/dsl4/play/tutorial-play-04-camera-permission.png",
      "captionDraft": "ポーズ認識を使うため、現在のsiteへcamera利用を許可します。",
      "altDraft": "紙芝居siteによるcamera利用の許可を求めるbrowser dialog",
      "gates": ["dsl4-release", "tutorial-sample", "capture-environment"]
    },
    {
      "id": "P-05",
      "tutorial": "play",
      "step": 4,
      "required": true,
      "status": "blocked",
      "surface": "pose recognition",
      "description": "カメラ映像、ポーズ案内、認識度、チャージ",
      "filename": "docs/images/tutorials/dsl4/play/tutorial-play-05-pose-progress.png",
      "captionDraft": "案内されたポーズを取り、認識度とチャージを確認します。",
      "altDraft": "camera previewの横に現在のポーズ、認識度、チャージが表示された認識画面",
      "gates": [
        "dsl4-release",
        "tutorial-sample",
        "app-shell",
        "pose-feedback",
        "capture-environment"
      ]
    },
    {
      "id": "P-06",
      "tutorial": "play",
      "step": 4,
      "required": true,
      "status": "blocked",
      "surface": "pose completion",
      "description": "ポーズ成立時のfeedback",
      "filename": "docs/images/tutorials/dsl4/play/tutorial-play-06-pose-complete.png",
      "captionDraft": "ポーズが成立すると成功feedbackが表示され、物語が進みます。",
      "altDraft": "ポーズ成立を示すfeedbackが表示された紙芝居画面",
      "gates": ["dsl4-release", "tutorial-sample", "app-shell", "pose-feedback"]
    },
    {
      "id": "P-07",
      "tutorial": "play",
      "step": 5,
      "required": true,
      "status": "blocked",
      "surface": "Standard app shell finished",
      "description": "終了画面と再実行またはタイトル復帰",
      "filename": "docs/images/tutorials/dsl4/play/tutorial-play-07-finished.png",
      "captionDraft": "終了後はもう一度遊ぶか、タイトルへ戻ります。",
      "altDraft": "紙芝居の終了状態と再実行およびタイトル復帰の操作",
      "gates": ["dsl4-release", "tutorial-sample", "app-shell"]
    },
    {
      "id": "P-08",
      "tutorial": "play",
      "step": 6,
      "required": false,
      "conditional": "Standard app shellがcamera選択またはmirroring controlを提供する場合",
      "status": "blocked",
      "surface": "camera controls",
      "description": "camera選択と左右反転UI",
      "filename": "docs/images/tutorials/dsl4/play/tutorial-play-08-camera-controls.png",
      "captionDraft": "必要に応じてcameraとpreviewの左右反転を変更します。",
      "altDraft": "camera previewの周囲にcamera選択と左右反転のcontrolが表示された画面",
      "gates": ["dsl4-release", "tutorial-sample", "camera-controls", "capture-environment"]
    },
    {
      "id": "C-01",
      "tutorial": "create",
      "step": 2,
      "required": true,
      "status": "blocked",
      "surface": "text editor",
      "description": "starterを開いたeditorとファイルツリー",
      "filename": "docs/images/tutorials/dsl4/create/tutorial-create-01-starter-project.png",
      "captionDraft": "starterを開き、root直下の台本、アセット、pose model bundleを確認します。",
      "altDraft": "story.kamishibai.yaml、画像、音声、rescue-pose directoryがroot直下に並ぶstarterのファイルツリー",
      "gates": ["dsl4-release", "tutorial-sample", "capture-environment"]
    },
    {
      "id": "C-02",
      "tutorial": "create",
      "step": 3,
      "required": true,
      "status": "blocked",
      "surface": "Web Preview project open",
      "description": "Web Previewのプロジェクトを開く導線",
      "filename": "docs/images/tutorials/dsl4/create/tutorial-create-02-project-open.png",
      "captionDraft": "Web Previewで「プロジェクトを開く」を押します。",
      "altDraft": "project directoryを開くbuttonが表示されたWeb Preview",
      "gates": ["dsl4-release", "tutorial-sample", "preview-flow"]
    },
    {
      "id": "C-03",
      "tutorial": "create",
      "step": 3,
      "required": true,
      "status": "blocked",
      "surface": "browser directory picker",
      "description": "tutorial用project rootを選ぶfolder選択画面",
      "filename": "docs/images/tutorials/dsl4/create/tutorial-create-03-directory-picker.png",
      "captionDraft": "YAML fileではなく、starterのproject root directoryを選びます。",
      "altDraft": "tutorial-story project root directoryを選択しているbrowserのdirectory picker",
      "gates": ["dsl4-release", "tutorial-sample", "preview-flow", "capture-environment"]
    },
    {
      "id": "C-04",
      "tutorial": "create",
      "step": 3,
      "required": true,
      "status": "blocked",
      "surface": "development preview",
      "description": "projectをwatchして最初のsourceを実行するWeb Preview",
      "filename": "docs/images/tutorials/dsl4/create/tutorial-create-04-first-preview.png",
