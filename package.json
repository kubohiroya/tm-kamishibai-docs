{
  "name": "@kubohiroya/tmpose-kamishibai-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation source and GitHub Pages build for TMPose Kamishibai",
  "type": "module",
  "license": "SEE LICENSE IN LICENSES.md",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm docs:dsl4:check && node scripts/build-docs.mjs && node scripts/verify-build.mjs",
    "build:full": "pnpm docs:dsl4:check && node scripts/build-docs.mjs --force && node scripts/verify-build.mjs",
    "docs:dsl4:check": "node scripts/generate-dsl4-reference.mjs --check",
    "docs:dsl4:generate": "node scripts/generate-dsl4-reference.mjs",
    "docs:dsl4:sync": "node scripts/sync-dsl4-schema.mjs",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{js,mjs,cjs,json,yaml,yml}\" \".github/**/*.{yaml,yml}\" \"*.md\" \"docs/{developer-guides/{application-materials-guide,application-materials-guide-4.0,developer-guide,developer-guide-4.0,internal-specification,internal-specification-4.0,extension-guide,dsl-3.1-diagnostics-design,dependency-audit,release-smoke},tutorials/*,LICENSE}.md\" \"site/**/*.{html,css}\"",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test && pnpm build",
    "preview:document": "vivliostyle preview --config docs/vivliostyle.general.config.mjs",
    "preview:workshop": "vivliostyle preview --config docs/vivliostyle.workshop.config.mjs",
    "preview:staff": "vivliostyle preview --config docs/vivliostyle.staff.config.mjs"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@vivliostyle/cli": "11.1.0",
    "ajv": "8.18.0",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "rubygana": "github:kubohiroya/rubygana#649cba1138f73f71f514711716e9a61a858ba712",
    "typescript": "7.0.2",
    "yaml": "2.8.1"
  }
}
